apps/

# 2) 构建产物
shell/.gradle/
shell/app/build/
shell/core/build/
shell/build/
dist/
*.apk
*.pkg
*.zip

# 3) 本机配置与工具链
shell/local.properties
.tools/
.gradle-home/
.android/
.tmp/
backups/
designs/

