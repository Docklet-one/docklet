# 壳仓库只放源码

# 模块源码由「模块」对话维护，这里只保留空目录占位
apps/*
!apps/.gitkeep
!apps/README.md

# 构建产物
shell/.gradle/
shell/app/build/
shell/core/build/
shell/build/
dist/
*.apk
*.pkg
*.zip

# 本机配置与工具链
shell/local.properties
.tools/
.gradle-home/
.android/
.tmp/
backups/
designs/

# 可执行工具
*.exe
*.dll
*.dylib
*.so
*.log

*.broken

# 系统杂项
.DS_Store
Thumbs.db
