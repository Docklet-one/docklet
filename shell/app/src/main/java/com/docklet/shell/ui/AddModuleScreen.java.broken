    private void buildLocalInstall(LinearLayout content) {
        LinearLayout card = new LinearLayout(activity);
        card.setOrientation(VERTICAL);
        card.setPadding(dp(15), dp(15), dp(15), dp(15));
        card.setBackground(UiKit.rounded(activity, UiKit.SURFACE, 20f));
        content.addView(card, new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT
        ));

        card.addView(UiKit.text(activity, "从链接安�?, 15f, UiKit.INK, true));
        TextView sub = UiKit.text(
                activity,
                "直接下载 .pkg 并安装，适合开发机或临时测试包�?,
                10f,
                UiKit.MUTED,
                false
        );
        LinearLayout.LayoutParams subParams = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT
        );
        subParams.topMargin = dp(5);
        card.addView(sub, subParams);

        EditText url = field("https://example.com/app.pkg");
        url.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
        card.addView(url, fieldParams());

        TextView install = UiKit.primaryButton(activity, "下载并安�?);
        install.setOnClickListener(view -> {
            String link = url.getText().toString().trim();
            if (link.isEmpty()) {
                url.setError("请输入模块包 URL");
                return;
            }
            listener.onUrl(link, "");
        });
        LinearLayout.LayoutParams installParams = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, dp(46)
        );
        installParams.topMargin = dp(14);
        card.addView(install, installParams);

        TextView or = UiKit.text(activity, "或从本地选择", 10f, UiKit.FAINT, false);
        or.setGravity(Gravity.CENTER);
        LinearLayout.LayoutParams orParams = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT
        );
        orParams.topMargin = dp(14);
        content.addView(or, orParams);

        TextView pick = UiKit.secondaryButton(activity, "选择本地 .pkg");
        pick.setBackground(UiKit.ripple(activity, UiKit.ACCENT_SOFT, 16f));
        pick.setOnClickListener(view -> listener.onPickFile(""));
        LinearLayout.LayoutParams pickParams = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, dp(46)
        );
        pickParams.topMargin = dp(8);
        content.addView(pick, pickParams);

        TextView warning = UiKit.text(
                activity,
                "请自行确认安装包来源可靠。不明来源的模块包可能导致程序异常、数据风险或安全问题�?,
                10f,
                UiKit.DANGER,
                false
        );
        warning.setLineSpacing(dp(1), 1.2f);
        warning.setPadding(dp(10), dp(9), dp(10), dp(9));
        warning.setBackground(UiKit.rounded(activity, UiKit.DANGER_SOFT, 12f));
        LinearLayout.LayoutParams warningParams = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT
        );
        warningParams.topMargin = dp(14);
        content.addView(warning, warningParams);
    }

